# CONFLUENT_BOOTSTRAP_SERVER=pkc-xxxxx.region.provider.confluent.cloud:9092
# CONFLUENT_API_KEY=
# CONFLUENT_API_SECRET=
# CONFLUENT_TOPIC_PREFIX=marketpulse_trades_
# CONFLUENT_GROUP_ID=marketpulse-dashboard-v1
# Set only after the Flink output topic exists; independent of raw consumption.
# CONFLUENT_SIGNALS_TOPIC=marketpulse_signals
PUBLIC_APP_ORIGIN=https://golden007-prog.github.io
